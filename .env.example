# Settings for Broadsheet. Docker Compose reads this file.

# Host port the app is served on (http://localhost:8080 by default).
PORT_HOST=8080

# Anyone who can reach the port can create an account while this is "true".
# Set it to "false" once everyone who needs an account has one.
ALLOW_SIGNUP=true

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# Set to "true" when serving over HTTPS so the session cookie is sent only over TLS.
COOKIE_SECURE=false
